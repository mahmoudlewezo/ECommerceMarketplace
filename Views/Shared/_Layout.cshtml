<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - ECommerceMarketplace</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

          <link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet"
          href="~/ECommerceMarketplace.styles.css"
          asp-append-version="true" />
</head>

<body>

    <!-- ================= NAVBAR ================= -->

    <header>

        <nav class="navbar navbar-expand-lg marketplace-navbar">

            <div class="container">

                <!-- Logo -->

                <a class="navbar-brand marketplace-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="brand-icon">
                        <i class="bi bi-bag-fill"></i>
                    </span>

                    <span>
                        ECommerce<span class="brand-highlight">Marketplace</span>
                    </span>

                </a>


                <!-- Mobile Toggle -->

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <!-- Navbar Content -->

                <div class="collapse navbar-collapse"
                     id="mainNavbar">

                    <!-- Main Navigation -->

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">

                                Home

                            </a>

                        </li>

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Privacy">

                                Privacy

                            </a>

                        </li>

                        

                          @if (User.Identity?.IsAuthenticated == true)
{
    <!-- Products - Customer & Seller -->
    @if (User.IsInRole("Customer") || User.IsInRole("Seller"))
    {
        <li class="nav-item">
            <a class="nav-link"
               asp-controller="Products"
               asp-action="Catalog">
                <i class="bi bi-grid me-1"></i>
                Products
            </a>
        </li>
    }

    <!-- Seller -->
    @if (User.IsInRole("Seller"))
    {
        <li class="nav-item">
            <a class="nav-link"
               asp-controller="Products"
               asp-action="MyProducts">
                <i class="bi bi-box-seam me-1"></i>
                My Products
            </a>
        </li>
    }

    <!-- Admin -->
    @if (User.IsInRole("Admin"))
    {
        <li class="nav-item">
            <a class="nav-link"
               asp-controller="Products"
               asp-action="Catalog">
                <i class="bi bi-grid me-1"></i>
                Products
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link admin-nav-link"
               asp-controller="Admin"
               asp-action="Products">
                <i class="bi bi-box-seam me-1"></i>
                Manage Products
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link admin-nav-link"
               asp-controller="Admin"
               asp-action="Index">
                <i class="bi bi-speedometer2 me-1"></i>
                Admin Dashboard
            </a>
        </li>
    }

                        }

                    </ul>


                    <!-- Right Side -->

                    <div class="navbar-user-area">

                        <partial name="_LoginPartial" />

                    </div>

                </div>

            </div>

        </nav>

    </header>


    <!-- ================= MAIN ================= -->

    <main>

        <div class="container page-container">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success custom-alert">

                    <i class="bi bi-check-circle-fill me-2"></i>

                    @TempData["Success"]

                </div>
            }

            @if (TempData["Info"] != null)
            {
                <div class="alert alert-info custom-alert">

                    <i class="bi bi-info-circle-fill me-2"></i>

                    @TempData["Info"]

                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger custom-alert">

                    <i class="bi bi-exclamation-triangle-fill me-2"></i>

                    @TempData["Error"]

                </div>
            }

            @RenderBody()

        </div>

    </main>


    <!-- ================= FOOTER ================= -->

    <footer class="marketplace-footer">

        <div class="container">

            <div class="row">

                <div class="col-md-6">

                    <h5 class="footer-brand">
                        ECommerceMarketplace
                    </h5>

                    <p>
                        A modern marketplace connecting customers
                        and sellers in one platform.
                    </p>

                </div>


                <div class="col-md-3">

                    <h6>Quick Links</h6>

                    <a asp-controller="Home"
                       asp-action="Index">
                        Home
                    </a>

                    <a asp-controller="Home"
                       asp-action="Privacy">
                        Privacy
                    </a>

                </div>


                <div class="col-md-3">

                    <h6>Account</h6>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span>
                            @User.Identity.Name
                        </span>
                    }
                    else
                    {
                        <a asp-controller="Account"
                           asp-action="Login">
                            Login
                        </a>

                        <a asp-controller="Account"
                           asp-action="Register">
                            Register
                        </a>
                    }

                </div>

            </div>


            <hr />

            <div class="footer-bottom">

                <span>
                    © 2026 ECommerceMarketplace
                </span>

                <span>
                    Built with ASP.NET Core MVC
                </span>

            </div>

        </div>

    </footer>


    <!-- ================= SCRIPTS ================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
