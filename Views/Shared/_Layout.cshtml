<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@(string.IsNullOrWhiteSpace(ViewData["Title"] as string) ? "Asrar" : ViewData["Title"] + " — Asrar")</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=IBM+Plex+Mono:wght@400;500&family=Outfit:wght@400;500;600;700&display=swap" />

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/ECommerceMarketplace.styles.css"
          asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg marketplace-navbar">
            <div class="container">
                <a class="navbar-brand marketplace-brand"
                   asp-controller="Home"
                   asp-action="Index">
                    <span class="brand-icon">
                        <i class="bi bi-diamond"></i>
                    </span>
                    <span>Asrar<span class="brand-mark">.</span></span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Products"
                               asp-action="Catalog">
                                Shop
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @if (User.IsInRole("Customer"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Cart" asp-action="Index">
                                        <i class="bi bi-bag me-1"></i>
                                        Cart
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Wishlist" asp-action="Index">
                                        <i class="bi bi-heart me-1"></i>
                                        Wishlist
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Orders" asp-action="Index">
                                        <i class="bi bi-receipt me-1"></i>
                                        My Orders
                                    </a>
                                </li>
                            }

                            @if (User.IsInRole("Seller"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Products"
                                       asp-action="MyProducts">
                                        <i class="bi bi-box-seam me-1"></i>
                                        My Products
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="SellerOrders" asp-action="Index">
                                        <i class="bi bi-clipboard-data me-1"></i>
                                        Seller Orders
                                    </a>
                                </li>
                            }

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Admin"
                                       asp-action="Index">
                                        Dashboard
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="Admin"
                                       asp-action="Products">
                                        Products
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link"
                                       asp-controller="AdminOrders"
                                       asp-action="Index">
                                        Orders
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <div class="navbar-user-area">
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main>
        <div class="container">
            @if (TempData["Success"] != null)
            {
                <div class="alert custom-alert alert-success mt-4 mb-0">
                    <i class="bi bi-check-circle me-2"></i>
                    @TempData["Success"]
                </div>
            }

            @if (TempData["Info"] != null)
            {
                <div class="alert custom-alert alert-info mt-4 mb-0">
                    <i class="bi bi-info-circle me-2"></i>
                    @TempData["Info"]
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert custom-alert alert-danger mt-4 mb-0">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    @TempData["Error"]
                </div>
            }
        </div>

        @if (ViewData["FullWidth"] as bool? == true)
        {
            @RenderBody()
        }
        else
        {
            <div class="container page-container">
                @RenderBody()
            </div>
        }
    </main>

    <footer class="marketplace-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-6">
                    <h5 class="footer-brand">Asrar</h5>
                    <p>
                        A quiet marketplace for pieces worth keeping —
                        fashion, objects, and everyday luxuries from independent sellers.
                    </p>
                </div>

                <div class="col-md-3">
                    <h6 class="kicker">Explore</h6>
                    <a asp-controller="Home" asp-action="Index">Home</a>
                    <a asp-controller="Products" asp-action="Catalog">Shop</a>
                    <a asp-controller="Home" asp-action="Privacy">Privacy</a>
                </div>

                <div class="col-md-3">
                    <h6 class="kicker">Account</h6>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span>@User.Identity.Name</span>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login">Login</a>
                        <a asp-controller="Account" asp-action="Register">Register</a>
                    }
                </div>
            </div>

            <hr />

            <div class="footer-bottom">
                <span>© 2026 Asrar</span>
                <span>Independent sellers. Considered goods.</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
