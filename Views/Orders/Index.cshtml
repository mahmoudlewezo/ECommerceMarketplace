@model IEnumerable<ECommerceMarketplace.ViewModels.Order.OrderListItemViewModel>
@{
    ViewData["Title"] = "My Orders";
}

<h2>Orders</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Order #</th>
            <th>Date</th>
            <th>Status</th>
            <th>Total</th>
            <th>Items</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var o in Model)
{
    <tr>
        <td><a asp-action="Details" asp-route-id="@o.Id">@o.Id</a></td>
        <td>@o.OrderDate.ToString("g")</td>
        <td>@o.Status</td>
        <td>@o.TotalPrice.ToString("C")</td>
        <td>@o.ItemCount</td>
        <td>
            <a class="btn btn-sm btn-primary" asp-action="Details" asp-route-id="@o.Id">Details</a>
            @if ((User.IsInRole("Customer") || User.IsInRole("Admin")) && (o.Status == "Pending" || o.Status == "Confirmed"))
            {
                <form asp-action="Cancel" asp-route-id="@o.Id" method="post" style="display:inline">
                    <button type="submit" class="btn btn-sm btn-danger">Cancel</button>
                </form>
            }
        </td>
    </tr>
}
    </tbody>
</table>
