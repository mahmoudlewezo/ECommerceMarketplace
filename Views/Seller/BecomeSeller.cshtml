@model ECommerceMarketplace.ViewModels.Seller.BecomeSellerViewModel

@{
    ViewData["Title"] = "Become a Seller";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="auth-panel">
            <div class="auth-body">
                <p class="kicker">Sellers</p>
                <h1 class="h2 mb-2">Become a seller</h1>
                <p class="text-muted mb-4">
                    Tell us why you want a stall on Asrar. An administrator will
                    review your request. If you already have a pending request,
                    you will be asked to wait.
                </p>

                <form asp-action="BecomeSeller" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="mb-4">
                        <label asp-for="Reason" class="form-label"></label>
                        <textarea asp-for="Reason"
                                  class="form-control"
                                  rows="6"
                                  placeholder="Tell us what you plan to offer..."></textarea>
                        <span asp-validation-for="Reason" class="text-danger"></span>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-primary px-4">
                            Submit request
                        </button>
                        <a asp-controller="Home"
                           asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
