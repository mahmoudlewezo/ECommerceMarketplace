@model ECommerceMarketplace.Models.Cart

<div class="container mt-4">
    <h2>Shopping Cart</h2>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (Model == null || !Model.CartItems.Any())
    {
        <p>The cart is empty.</p>
    }
    else
    {
        <table class="table table-bordered align-middle">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Price</th>
                    <th>Quantity</th>
                    <th>Total</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.CartItems)
                {
                    <tr>
                        <td>@item.Product.Name</td>
                        <td>@item.Product.Price.ToString("C")</td>
                        <td>@item.Quantity</td>
                        <td>@((item.Quantity * item.Product.Price).ToString("C"))</td>
                        <td>
                            <form asp-controller="Cart" asp-action="RemoveFromCart" method="post">
                                <input type="hidden" name="cartItemId" value="@item.Id" />
                                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <h4>Total: @Model.CartItems.Sum(i => i.Quantity * i.Product.Price).ToString("C")</h4>
            <form asp-controller="Checkout" asp-action="ProcessCheckout" method="post">
                <button type="submit" class="btn btn-success btn-lg">Complete Purchase (Checkout)</button>
            </form>
        </div>
    }
</div>
