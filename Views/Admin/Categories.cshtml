@model IEnumerable<ECommerceMarketplace.Models.Category>

@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold mb-1">Categories</h2>
        <p class="text-muted mb-0">
            Manage marketplace product categories.
        </p>
    </div>

    <a asp-action="CreateCategory"
       class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>
        Add Category
    </a>

</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">

            <i class="bi bi-tags fs-1 text-muted"></i>

            <h4 class="fw-bold mt-3">
                No Categories
            </h4>

            <p class="text-muted">
                Start by adding your first category.
            </p>

        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Products</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var category in Model)
                    {
                        <tr>

                            <td>
                                <span class="fw-semibold">
                                    @category.Name
                                </span>
                            </td>

                            <td>
                                <span class="text-muted">
                                    @(string.IsNullOrWhiteSpace(category.Description)
                                        ? "No description"
                                        : category.Description)
                                </span>
                            </td>

                            <td>
                                <span class="badge bg-primary">
                                    @category.Products.Count
                                </span>
                            </td>

                            <td class="text-end">

                                <a asp-action="EditCategory"
                                   asp-route-id="@category.Id"
                                   class="btn btn-sm btn-outline-warning">
                                    <i class="bi bi-pencil"></i>
                                    Edit
                                </a>

                                @if (!category.Products.Any())
                                {
                                    <form asp-action="DeleteCategory"
                                          asp-route-id="@category.Id"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('Are you sure you want to delete this category?');">

                                            <i class="bi bi-trash"></i>
                                            Delete

                                        </button>

                                    </form>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
}