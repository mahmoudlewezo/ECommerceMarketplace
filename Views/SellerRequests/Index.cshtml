@model IEnumerable<ECommerceMarketplace.Models.SellerRequest>

@{
    ViewData["Title"] = "Seller Requests";
}

<div class="container mt-5">

    <h2 class="mb-4">Seller Requests</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info">
            @TempData["Info"]
        </div>
    }

    <div class="table-responsive">

        <table class="table table-bordered table-hover">

            <thead>
                <tr>
                    <th>User</th>
                    <th>Email</th>
                    <th>Reason</th>
                    <th>Status</th>
                    <th>Created At</th>
                    <th>Reviewed At</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var request in Model)
                {
                    <tr>

                        <td>
                            @request.User.FullName
                        </td>

                        <td>
                            @request.User.Email
                        </td>

                        <td>
                            @request.Reason
                        </td>

                        <td>
                            @if (request.Status == SellerRequestStatus.Pending)
                            {
                                <span class="badge bg-warning text-dark">
                                    Pending
                                </span>
                            }
                            else if (request.Status == SellerRequestStatus.Approved)
                            {
                                <span class="badge bg-success">
                                    Approved
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Rejected
                                </span>
                            }
                        </td>

                        <td>
                            @request.CreatedAt.ToLocalTime()
                        </td>

                        <td>
                            @(request.ReviewedAt?.ToLocalTime().ToString()
                                ?? "-")
                        </td>

                        <td>

                            @if (request.Status == SellerRequestStatus.Pending)
                            {
                                <form asp-action="Approve"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@request.Id" />

                                    <button type="submit"
                                            class="btn btn-success btn-sm">
                                        Approve
                                    </button>

                                </form>

                                <form asp-action="Reject"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@request.Id" />

                                    <button type="submit"
                                            class="btn btn-danger btn-sm">
                                        Reject
                                    </button>

                                </form>
                            }
                            else
                            {
                                <span class="text-muted">
                                    Reviewed
                                </span>
                            }

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>
</div>