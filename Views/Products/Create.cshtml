@model ECommerceMarketplace.ViewModels.Product.CreateProductViewModel

@{
    ViewData["Title"] = "Add Product";
}

<div class="row justify-content-center">
    <div class="col-lg-8">

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">

                <div class="mb-4">
                    <h2 class="fw-bold mb-1">Add New Product</h2>
                    <p class="text-muted mb-0">
                        Add a new product to your store.
                    </p>
                </div>

                <form asp-action="Create"
                      method="post"
                      enctype="multipart/form-data">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="row">

                        <!-- Product Name -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="Name"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Enter product name" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>
                        </div>

                        <!-- Category -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="CategoryId"
                                   class="form-label fw-semibold">
                                Category
                            </label>

                            <select asp-for="CategoryId"
                                    class="form-select">

                                <option value="">
                                    -- Select Category --
                                </option>

                                @foreach (var category in ViewBag.Categories)
                                {
                                    <option value="@category.Id">
                                        @category.Name
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="CategoryId"
                                  class="text-danger">
                            </span>
                        </div>

                        <!-- Price -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="Price"
                                   class="form-label fw-semibold">
                            </label>

                            <div class="input-group">
                                <span class="input-group-text">$</span>

                                <input asp-for="Price"
                                       class="form-control"
                                       type="number"
                                       step="0.01"
                                       min="0.01"
                                       placeholder="0.00" />
                            </div>

                            <span asp-validation-for="Price"
                                  class="text-danger">
                            </span>
                        </div>

                        <!-- Quantity -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="AvailableQuantity"
                                   class="form-label fw-semibold">
                                Available Quantity
                            </label>

                            <input asp-for="AvailableQuantity"
                                   class="form-control"
                                   type="number"
                                   min="0"
                                   placeholder="Enter quantity" />

                            <span asp-validation-for="AvailableQuantity"
                                  class="text-danger">
                            </span>
                        </div>

                        <!-- Description -->
                        <div class="col-12 mb-3">
                            <label asp-for="Description"
                                   class="form-label fw-semibold">
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="5"
                                      placeholder="Describe your product...">
                            </textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger">
                            </span>
                        </div>

                        <!-- Image -->
                        <div class="col-12 mb-4">
                            <label asp-for="Image"
                                   class="form-label fw-semibold">
                                Product Image
                            </label>

                            <input asp-for="Image"
                                   type="file"
                                   class="form-control"
                                   accept="image/*" />

                            <div class="form-text">
                                Upload a clear image of your product.
                            </div>

                            <span asp-validation-for="Image"
                                  class="text-danger">
                            </span>
                        </div>

                    </div>

                    <div class="d-flex justify-content-end gap-2">

                        <a asp-action="MyProducts"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>

                        <button type="submit"
                                class="btn btn-primary px-4">
                            Add Product
                        </button>

                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}