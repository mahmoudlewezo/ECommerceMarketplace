@model ECommerceMarketplace.ViewModels.Product.EditProductViewModel

@{
    ViewData["Title"] = "Edit Product";
}

<div class="row justify-content-center">
    <div class="col-lg-8">

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">

                <div class="mb-4">
                    <h2 class="fw-bold mb-1">Edit Product</h2>
                    <p class="text-muted mb-0">
                        Update your product information.
                    </p>
                </div>

                <form asp-action="Edit"
                      method="post"
                      enctype="multipart/form-data">

                    @Html.AntiForgeryToken()

                    <input type="hidden" asp-for="Id" />

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="row">

                        <!-- Name -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="Name"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Name"
                                   class="form-control" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>
                        </div>

                        <!-- Category -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="CategoryId"
                                   class="form-label fw-semibold">
                                Category
                            </label>

                            <select asp-for="CategoryId"
                                    class="form-select">

                                <option value="">
                                    -- Select Category --
                                </option>

                                @foreach (var category in ViewBag.Categories)
                                {
                                    <option value="@category.Id">
                                        @category.Name
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="CategoryId"
                                  class="text-danger">
                            </span>
                        </div>

                        <!-- Price -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="Price"
                                   class="form-label fw-semibold">
                            </label>

                            <div class="input-group">
                                <span class="input-group-text">$</span>

                                <input asp-for="Price"
                                       class="form-control"
                                       type="number"
                                       step="0.01"
                                       min="0.01" />
                            </div>

                            <span asp-validation-for="Price"
                                  class="text-danger">
                            </span>
                        </div>

                        <!-- Quantity -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="AvailableQuantity"
                                   class="form-label fw-semibold">
                                Available Quantity
                            </label>

                            <input asp-for="AvailableQuantity"
                                   class="form-control"
                                   type="number"
                                   min="0" />

                            <span asp-validation-for="AvailableQuantity"
                                  class="text-danger">
                            </span>
                        </div>

                        <!-- Description -->
                        <div class="col-12 mb-3">
                            <label asp-for="Description"
                                   class="form-label fw-semibold">
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="5">
                            </textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger">
                            </span>
                        </div>

                        <!-- Current Image -->
                        @if (!string.IsNullOrEmpty(Model.CurrentImageUrl))
                        {
                            <div class="col-12 mb-3">

                                <label class="form-label fw-semibold">
                                    Current Image
                                </label>

                                <div>
                                    <img src="@Model.CurrentImageUrl"
                                         alt="@Model.Name"
                                         class="rounded shadow-sm"
                                         style="width:180px;height:180px;object-fit:cover;" />
                                </div>

                            </div>
                        }

                        <!-- New Image -->
                        <div class="col-12 mb-4">

                            <label asp-for="Image"
                                   class="form-label fw-semibold">
                                Replace Image
                            </label>

                            <input asp-for="Image"
                                   type="file"
                                   class="form-control"
                                   accept="image/*" />

                            <div class="form-text">
                                Leave empty to keep the current image.
                            </div>

                            <span asp-validation-for="Image"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                    <div class="d-flex justify-content-end gap-2">

                        <a asp-action="MyProducts"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>

                        <button type="submit"
                                class="btn btn-warning px-4">
                            Save Changes
                        </button>

                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}