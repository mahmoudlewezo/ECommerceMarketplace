@model IEnumerable<ECommerceMarketplace.ViewModels.Product.ProductIndexViewModel>

@{
    ViewData["Title"] = "Shop";
}

<div class="mb-4">
    <p class="kicker">Catalog</p>
    <h1 class="h2 mb-2">The shop</h1>
    <p class="text-muted mb-0">
        Search, filter by category, and sort. Images are the listings our sellers already keep.
    </p>
</div>

<form asp-action="Catalog"
      method="get"
      class="catalog-toolbar">
    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label">Search</label>
            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   class="form-control"
                   placeholder="Search products..." />
        </div>

        <div class="col-md-3">
            <label class="form-label">Category</label>
            <select name="categoryId" class="form-select">
                <option value="">All Categories</option>
                @foreach (var category in ViewBag.Categories)
                {
                    if (ViewBag.CategoryId != null &&
                        (int)ViewBag.CategoryId == category.Id)
                    {
                        <option value="@category.Id" selected>
                            @category.Name
                        </option>
                    }
                    else
                    {
                        <option value="@category.Id">
                            @category.Name
                        </option>
                    }
                }
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label">Sort By</label>
            <select name="sort" class="form-select">
                <option value="">Latest</option>
                <option value="price_asc" selected="@(((ViewBag.Sort as string) == "price_asc") ? "selected" : null)">
                    Price: Low to High
                </option>
                <option value="price_desc" selected="@(((ViewBag.Sort as string) == "price_desc") ? "selected" : null)">
                    Price: High to Low
                </option>
                <option value="name_asc" selected="@(((ViewBag.Sort as string) == "name_asc") ? "selected" : null)">
                    Name: A-Z
                </option>
                <option value="name_desc" selected="@(((ViewBag.Sort as string) == "name_desc") ? "selected" : null)">
                    Name: Z-A
                </option>
            </select>
        </div>

        <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">
                Apply
            </button>
        </div>
    </div>
</form>

@if (!Model.Any())
{
    <div class="empty-state">
        <h3>No products found</h3>
        <p class="text-muted mb-0">
            Try a different search or category.
        </p>
    </div>
}
else
{
    <p class="text-muted mb-3">
        @Model.Count() listing@(Model.Count() == 1 ? "" : "s")
    </p>

    <div class="row g-4">
        @foreach (var product in Model)
        {
            <div class="col-12 col-sm-6 col-lg-4 col-xl-3">
                <article class="product-card">
                    <div class="product-media">
                        @if (!string.IsNullOrEmpty(product.ImageUrl))
                        {
                            <img src="@product.ImageUrl" alt="@product.Name" />
                        }
                        else
                        {
                            <div class="product-media-fallback">No image</div>
                        }
                    </div>
                    <div class="product-card-body">
                        <span class="badge bg-secondary align-self-start">
                            @product.CategoryName
                        </span>
                        <h3>@product.Name</h3>
                        <p class="text-muted small mb-3">
                            @(product.Description.Length > 90
                                ? product.Description.Substring(0, 90) + "..."
                                : product.Description)
                        </p>
                        <div class="mt-auto">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="product-price">
                                    @product.Price.ToString("C")
                                </span>
                                @if (product.AvailableQuantity > 0)
                                {
                                    <span class="badge bg-success">In stock</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Out of stock</span>
                                }
                            </div>
                            <a asp-action="Details"
                               asp-route-id="@product.Id"
                               class="btn btn-outline-primary w-100">
                                View details
                            </a>
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
}
