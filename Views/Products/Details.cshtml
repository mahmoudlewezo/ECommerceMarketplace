@model ECommerceMarketplace.ViewModels.Product.ProductDetailsViewModel

@{
    ViewData["Title"] = Model.Name;
}

<div class="pdp">
    <div class="row g-0">
        <div class="col-md-5 pdp-media">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="@Model.Name" />
            }
            else
            {
                <div class="product-media-fallback">No image available</div>
            }
        </div>
        <div class="col-md-7">
            <div class="pdp-body">
                <span class="badge bg-secondary mb-3">
                    @Model.CategoryName
                </span>
                <h1 class="h2 mb-3">@Model.Name</h1>
                <p class="text-muted">
                    @Model.Description
                </p>
                <hr />
                <div class="row mb-3">
                    <div class="col-6">
                        <small class="form-label d-block mb-1">Price</small>
                        <div class="product-price">
                            @Model.Price.ToString("C")
                        </div>
                    </div>
                    <div class="col-6">
                        <small class="form-label d-block mb-1">Availability</small>
                        <div class="fw-semibold">
                            @if (Model.AvailableQuantity > 0)
                            {
                                <span>@Model.AvailableQuantity in stock</span>
                            }
                            else
                            {
                                <span class="text-danger">Out of stock</span>
                            }
                        </div>
                    </div>
                </div>
                <div class="mb-4">
                    <small class="form-label d-block mb-1">Seller</small>
                    <div class="fw-semibold">@Model.SellerName</div>
                </div>

                <div class="pdp-actions">
                    @if (User.IsInRole("Customer"))
                    {
                        @if (Model.AvailableQuantity > 0)
                        {
                            <form asp-controller="Cart"
                                  asp-action="AddToCart"
                                  method="get"
                                  class="d-flex flex-wrap gap-2 align-items-center">
                                <input type="hidden" name="productId" value="@Model.Id" />
                                <input class="form-control qty-input"
                                       type="number"
                                       name="quantity"
                                       value="1"
                                       min="1"
                                       max="@Model.AvailableQuantity" />
                                <button type="submit" class="btn btn-primary">
                                    Add to cart
                                </button>
                            </form>
                        }
                        else
                        {
                            <button type="button" class="btn btn-primary" disabled>
                                Out of stock
                            </button>
                        }

                        <a asp-controller="Wishlist"
                           asp-action="AddToWishlist"
                           asp-route-productId="@Model.Id"
                           class="btn btn-outline-primary">
                            Add to wishlist
                        </a>
                    }

                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Admin"
                           asp-action="Products"
                           class="btn btn-outline-secondary">
                            Back to products
                        </a>
                    }
                    else if (User.IsInRole("Seller"))
                    {
                        <a asp-controller="Products"
                           asp-action="MyProducts"
                           class="btn btn-outline-secondary">
                            Back to my products
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Products"
                           asp-action="Catalog"
                           class="btn btn-outline-secondary">
                            Back to shop
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
